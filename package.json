{
  "name": "api-update",
  "version": "0.1.0",
  "private": true,
  "description": "Stripe/OpenAI API の破壊的変更を検知し、自動修正PRを作成する GitHub App",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "seed:baseline": "tsx src/scripts/seed-baseline.ts",
    "analyze": "tsx src/scripts/analyze-local.ts",
    "fix": "tsx src/scripts/fix-local.ts",
    "pipeline": "tsx src/scripts/run-pipeline.ts",
    "verify:github": "tsx src/scripts/verify-github-auth.ts",
    "verify:llm": "tsx src/scripts/verify-llm-offline.ts",
    "generate:slack-go-map": "tsx src/scripts/generate-slack-go-map.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2"
  }
}
