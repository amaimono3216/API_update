# ---- サーバ ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- データストア（docker compose 内のホスト名） ----
DATABASE_URL=postgres://api_update:api_update@db:5432/api_update
REDIS_URL=redis://redis:6379

# ホスト側に公開するポート（衝突する場合のみ変更）
DB_PORT=5432
REDIS_PORT=6379

# ---- GitHub App（④ PR 生成） ----
# 未設定の場合、④ は PR 内容の生成のみ行い、GitHub への送信はスキップする
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ---- LLM（② 影響判定 / ③ Fix Agent） ----
# 未設定の場合、② の LLM 判定はスキップされ全件 uncertain になる
ANTHROPIC_API_KEY=

# ---- 監視対象 API スペック（① Update Detector） ----
STRIPE_OPENAPI_URL=https://raw.githubusercontent.com/stripe/openapi/master/openapi/spec3.json
OPENAI_OPENAPI_URL=https://raw.githubusercontent.com/openai/openai-openapi/master/openapi.yaml

# ---- 検知スケジュール（① Update Detector） ----
DETECT_ENABLED=true
DETECT_CRON=0 3 * * *
DETECT_TIMEZONE=Asia/Tokyo
